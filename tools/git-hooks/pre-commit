#!/usr/bin/env bash
#
# pre-commit: refuse secrets and failing tests. Silent on success, because a gate that
# prints on every clean commit trains you to stop reading it.
#
# Installed by tools/install-hooks.sh.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  if ! out="$(gitleaks git --staged --no-banner --redact 2>&1)"; then
    echo "$out" >&2
    cat >&2 <<'EOF'

COMMIT BLOCKED: gitleaks found a credential in the staged changes.
This repo is public, so once pushed, the only remedy is to rotate the credential.
If it's a false positive, unstage the file or add a narrow rule to a gitleaks config.
EOF
    exit 1
  fi
else
  # A missing tool must never lock the repo, but it must not pass quietly either.
  echo "pre-commit: gitleaks is not installed, so the secret scan was SKIPPED (brew install gitleaks)" >&2
fi

python="$root/.venv/bin/python"
[[ -x "$python" ]] || python="python3"
if ! out="$("$python" -m pytest -q --rootdir="$root" "$root/tests" 2>&1)"; then
  echo "$out" | tail -30 >&2
  echo >&2
  echo "COMMIT BLOCKED: tests failed." >&2
  exit 1
fi
